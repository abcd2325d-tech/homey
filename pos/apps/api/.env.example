# ── Database ────────────────────────────────────────────────────────────
# "sqlite" for local dev, "postgresql" for production.
DATABASE_PROVIDER=sqlite
# sqlite: a file path URL. postgresql: postgresql://user:pass@host:5432/dbname
DATABASE_URL="file:./dev.db"

# ── Auth ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# ── Barcode lookup providers ───────────────────────────────────────────
# Comma-separated, queried in this order until one finds the product.
# Supported: upcitemdb, openfoodfacts, amazon
BARCODE_LOOKUP_PROVIDERS=openfoodfacts,amazon
BARCODE_LOOKUP_TIMEOUT_MS=4000

# UPCitemdb (https://www.upcitemdb.com/api) — free trial key, optional.
UPCITEMDB_API_KEY=

# Open Food Facts needs no API key (open data).

# Amazon Product Advertising API — optional, requires an approved Associates account.
AMAZON_PAAPI_ACCESS_KEY=
AMAZON_PAAPI_SECRET_KEY=
AMAZON_PAAPI_PARTNER_TAG=
AMAZON_PAAPI_REGION=us-east-1
AMAZON_PAAPI_HOST=webservices.amazon.com
